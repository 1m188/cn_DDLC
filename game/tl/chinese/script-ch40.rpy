# script-ch40.rpyc:73
translate chinese ch40_main_9e6d8d68:

    # "After all, how could I tell her that clubs are a waste of time..."
    "毕竟，我怎么能当着她的面说社团是浪费时间……"

# script-ch40.rpyc:74
translate chinese ch40_main_3e5004bd:

    # "...when she's starting a club of her very own?"
    "……而她正打算创办自己的社团呢？"

# script-ch40.rpyc:75
translate chinese ch40_main_0021b572:

    # mc "...Actually, yeah."
    mc "……其实，有了。"

# script-ch40.rpyc:76
translate chinese ch40_main_73917420:

    # mc "I think I've decided on a club."
    mc "我想好要加入哪个社团了。"

# script-ch40.rpyc:78
translate chinese ch40_main_33f39455:

    # s 1m "Really?!"
    s 1m "真的吗？！"

# script-ch40.rpyc:79
translate chinese ch40_main_87e83572:

    # s 1r "Which one? Tell me!"
    s 1r "哪个？快告诉我！"

# script-ch40.rpyc:80
translate chinese ch40_main_8fea2db2:

    # mc "Hmm..."
    mc "嗯……"

# script-ch40.rpyc:81
translate chinese ch40_main_1388d67c:

