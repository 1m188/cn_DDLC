translate chinese yuri_exclusive_1_7c7d4031:

    # mc "I mean, I can definitely enjoy those kinds of stories, so don't worry."
    mc "我是说，我也挺能欣赏这类故事的，别担心。"

# script-exclusives-yuri.rpyc:62
translate chinese yuri_exclusive_1_3c899c8c:

    # y 2u "I hope so..."
    y 2u "那就好……"

# script-exclusives-yuri.rpyc:63
