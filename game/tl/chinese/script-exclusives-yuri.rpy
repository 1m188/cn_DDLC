    "我拿起巧克力，放进她嘴里。"

# script-exclusives-yuri.rpyc:548
translate chinese yuri_exclusive_2_ch3_27867937:

    # "I feel her hot breath on my fingers."
    "我感觉到她温热的气息拂过我的指尖。"

# script-exclusives-yuri.rpyc:555
translate chinese yuri_exclusive_2_ch3_90de9c4d:

    # m "Okay, everyone!"
    m "好了，各位！"

# script-exclusives-yuri.rpyc:556
