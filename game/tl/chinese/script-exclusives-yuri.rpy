    mc "嗯……"

# script-exclusives-yuri.rpyc:577
translate chinese yuri_exclusive_2_ch3_9fcc188d:

    # "Yuri picks up the teacups from the floor."
    "优里把茶杯从地上捡起来。"

# script-exclusives-yuri.rpyc:578
translate chinese yuri_exclusive_2_ch3_a8008265:

    # "I pick up the bag of chocolates."
