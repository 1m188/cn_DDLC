    # m "Okay, thanks!"
    m "好，谢谢！"

# script-exclusives-yuri.rpyc:571
translate chinese yuri_exclusive_2_ch3_89cc198f:

    # "The spell is abruptly broken."
    "那咒语般的氛围被骤然打破。"

# script-exclusives-yuri.rpyc:572
translate chinese yuri_exclusive_2_ch3_09df592d:

    # y 4c "I'll..."
    y 4c "我……"

