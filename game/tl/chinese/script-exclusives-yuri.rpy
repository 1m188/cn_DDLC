translate chinese yuri_exclusive_1_5daab38f:

    # y "I mean--"
    y "我是说——"

# script-exclusives-yuri.rpyc:33
translate chinese yuri_exclusive_1_1fb27bb9:

    # y 1w "I...just happened to buy two of them."
    y 1w "我……只是碰巧买了两本。"

