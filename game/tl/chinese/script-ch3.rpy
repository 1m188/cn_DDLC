# script-ch3.rpyc:6
translate chinese ch3_main_9f4a56c4:

    # m "Aw, man..."
    m "哎呀……"

# script-ch3.rpyc:7
translate chinese ch3_main_055e03b2:

    # m "I'm the last one here again!"
    m "我又成了最后一个到的！"

# script-ch3.rpyc:8
translate chinese ch3_main_b7e281fe:

    # mc "Don't worry, I just walked in too."
    mc "别在意，我也刚进门。"

# script-ch3.rpyc:10
translate chinese ch3_main_c3ef2d3c:

    # y "Were you practicing piano again?"
    y "你又在练钢琴了吗？"

# script-ch3.rpyc:13
translate chinese ch3_main_45b8967d:

    # m 1l "Yeah..."
    m 1l "嗯……"

# script-ch3.rpyc:14
translate chinese ch3_main_f6daf90a:

    # m "Ahaha..."
    m "啊哈……"

# script-ch3.rpyc:17
translate chinese ch3_main_f6674ca2:

    # y 1m "You must have a lot of determination."
    y 1m "你真是很有毅力呢。"

# script-ch3.rpyc:18
translate chinese ch3_main_b3742316:

    # y "Starting this club, and now picking up piano..."
    y "创办了社团，如今又开始学钢琴……"

# script-ch3.rpyc:21
translate chinese ch3_main_d085cf7d:

    # m 1a "Well, maybe not determination..."
    m 1a "嗯，与其说是毅力……"

# script-ch3.rpyc:22
translate chinese ch3_main_3107ecc8:

    # m "But I guess passion."
    m "不如说是热情吧。"

# script-ch3.rpyc:23
translate chinese ch3_main_2a81fef4:

    # m "Remember that the club wouldn't be here if it wasn't for all of you."
    m "别忘了，没有你们，就没有这个社团。"

# script-ch3.rpyc:24
translate chinese ch3_main_c98c2ef3:

    # m 1b "And I'm super happy that you're all willing to help out for the festival, too!"
    m 1b "而且大家都愿意为学园祭出力，我超级开心的！"

# script-ch3.rpyc:27
translate chinese ch3_main_c579b59a:

    # n "Aaah, I can't wait for the festival!"
    n "啊啊，学园祭快点来吧！"

# script-ch3.rpyc:28
translate chinese ch3_main_0622f046:

    # n "It's gonna be great!"
    n "肯定超棒的！"

# script-ch3.rpyc:31
translate chinese ch3_main_8ce7a8ef:

    # m 1d "Eh?"
    m 1d "诶？"

# script-ch3.rpyc:32
translate chinese ch3_main_ab7ae29e:

    # m "Weren't you complaining about it just yesterday, Natsuki?"
    m "夏树，你昨天不是还在抱怨吗？"

# script-ch3.rpyc:35
translate chinese ch3_main_37f7579e:

    # n "Well, yeah."
    n "嗯，是啊。"

# script-ch3.rpyc:36
translate chinese ch3_main_f68bca32:

    # n "I'm not talking about {i}our{/i} part of the festival."
    n "我说的可不是{i}我们{/i}要出的节目。"

# script-ch3.rpyc:37
translate chinese ch3_main_0f6cfdeb:

    # n 4l "But it's a whole day of school where we get to play and eat all kinds of delicious food!"
    n 4l "那天可是一整天都在学校，能玩遍、吃遍各种好吃的！"

# script-ch3.rpyc:39
translate chinese ch3_main_54b06106:

    # mc "You sound a bit like Sayori all of a sudden..."
    mc "你这口气怎么突然变得跟纱世里一样……"

# script-ch3.rpyc:41
translate chinese ch3_main_cfe933b2:

    # n 4a "Monika! Do they usually have fried squid?"
    n 4a "莫妮卡！学园祭一般会有炸鱿鱼吗？"

# script-ch3.rpyc:44
translate chinese ch3_main_a6e88b1f:

    # m "Squid...?"
    m "鱿鱼……？"

# script-ch3.rpyc:45
translate chinese ch3_main_6c34f853:

    # m "That's a pretty specific thing to look forward to..."
    m "你这个期待也太具体了吧……"

# script-ch3.rpyc:48
translate chinese ch3_main_a4c7577e:

    # n "Oh, come on."
    n "拜托。"

# script-ch3.rpyc:49
translate chinese ch3_main_9440d258:

    # n "Are you saying you don't like squid?"
    n "你的意思是，你不爱吃鱿鱼？"

# script-ch3.rpyc:50
translate chinese ch3_main_1f8fa284:

    # n "You, of all people?"
    n "别人也就算了，偏偏是你？"

# script-ch3.rpyc:53
translate chinese ch3_main_6eb6bfe0:

    # m "Eh? I didn't say I don't like it."
    m "诶？我可没说我不爱吃。"

# script-ch3.rpyc:54
translate chinese ch3_main_d8ec5ced:

    # m "Besides, what do you mean by 'you of all people'?"
    m "话说，什么叫‘别人也就算了，偏偏是我’？"

# script-ch3.rpyc:57
translate chinese ch3_main_a0fd7848:

    # n "Because!"
    n "因为！"

# script-ch3.rpyc:58
translate chinese ch3_main_07187167:

    # n "It's right in your name!"
    n "你的名字里不就写着嘛！"

# script-ch3.rpyc:59
translate chinese ch3_main_8f497507:

    # n 4z "Mon-ika!"
    n 4z "莫妮卡（Mon-ika）！"

# script-ch3.rpyc:62
translate chinese ch3_main_5ddfdfed:

    # m "Eh?!"
    m "诶？！"

# script-ch3.rpyc:63
translate chinese ch3_main_6132dc6f:

    # m "That's not how you say my name at all!"
    m "那根本不是我名字的念法！"

# script-ch3.rpyc:64
translate chinese ch3_main_69ab772f:

    # m "Also, that joke makes no sense in translation!"
    m "还有，这个梗根本没法翻译成别的语言啦！"

# script-ch3.rpyc:67
translate chinese ch3_main_a5a5ad3d:

    # n 4m "...?"
    n 4m "……？"

# script-ch3.rpyc:70
translate chinese ch3_main_23054d2c:

    # m "Ah...never mind!"
    m "啊……当我没说！"

# script-ch3.rpyc:71
translate chinese ch3_main_bcac77c0:

    # m "Let's just focus on our own event for now, okay?"
    m "先专心准备我们自己的节目吧，好吗？"

# script-ch3.rpyc:74
translate chinese ch3_main_290c4793:

    # n "Ehehe."
    n "嘿嘿。"

# script-ch3.rpyc:75
translate chinese ch3_main_bb28cd81:

    # n "Fine, fine."
    n "行行行。"

# script-ch3.rpyc:76
translate chinese ch3_main_b2acf4f8:

    # n "Your reactions aren't as fun as Yuri's or Sayori's, anyway."
    n "反正你的反应也没优里和纱世里的有意思。"

# script-ch3.rpyc:79
translate chinese ch3_main_d07bdb0a:

    # y "Excuse me..."
    y "不好意思……"

# script-ch3.rpyc:81
translate chinese ch3_main_bf3989ea:

    # mc "Where is Sayori, anyway...?"
    mc "话说，纱世里人呢……？"

# script-ch3.rpyc:82
translate chinese ch3_main_e0642a0e:

    # mc "Oh, there you are."
    mc "哦，在那儿。"

# script-ch3.rpyc:87
translate chinese ch3_main_7a772057:

    # "Sayori is sitting at a desk in the corner of the room, looking down at nothing."
    "纱世里坐在教室角落的课桌前，低着头望着虚无。"

# script-ch3.rpyc:88
translate chinese ch3_main_45a1d633:

    # "I walk over to her."
    "我朝她走了过去。"

# script-ch3.rpyc:89
translate chinese ch3_main_64ca4d29:

    # mc "Hey, Sayori."
    mc "喂，纱世里。"

# script-ch3.rpyc:91
translate chinese ch3_main_34620dff:

    # "I wave my hand in front of her face."
    "我在她眼前挥了挥手。"

# script-ch3.rpyc:92
translate chinese ch3_main_d19b9137:

    # s 1n "Eh--?"
    s 1n "诶——？"

# script-ch3.rpyc:93
translate chinese ch3_main_290df0ce:

    # mc "You're spacing out again."
    mc "你又走神了。"

# script-ch3.rpyc:94
translate chinese ch3_main_82cca4a1:

    # s "A-Ah..."
    s "啊、啊……"

# script-ch3.rpyc:95
translate chinese ch3_main_3bfb671b:

    # s 4l "Ehehe, sorry..."
    s 4l "诶嘿嘿，抱歉……"

# script-ch3.rpyc:96
translate chinese ch3_main_5caa9a43:

    # s "Don't mind me."
    s "别管我啦。"

# script-ch3.rpyc:97
translate chinese ch3_main_636b7bc7:

    # s 4y "You can go talk to everyone else."
    s 4y "你去跟大家聊天吧。"

# script-ch3.rpyc:98
translate chinese ch3_main_5693a819:

    # mc "Huh..."
    mc "唔……"

# script-ch3.rpyc:99
translate chinese ch3_main_86bcc222:

    # mc "Is everything alright?"
    mc "你没事吧？"

# script-ch3.rpyc:100
translate chinese ch3_main_d6ab89ea:

    # s 1h "O-Of course!"
    s 1h "当、当然没事！"

# script-ch3.rpyc:101
translate chinese ch3_main_c72e5106:

    # s "Why wouldn't it be?"
    s "怎么可能有事？"

# script-ch3.rpyc:102
translate chinese ch3_main_9136ec5d:

    # mc "It just feels like you're a little off..."
    mc "总觉得你今天有点不太对劲……"

# script-ch3.rpyc:103
translate chinese ch3_main_a16a7353:

    # mc "Sorry for assuming things."
    mc "抱歉，是我自作多情了。"

# script-ch3.rpyc:104
translate chinese ch3_main_c904bbeb:

    # s "Jeez, you worry too much about me."
    s "真是的，你太爱操心了。"

# script-ch3.rpyc:105
translate chinese ch3_main_afbc6df5:

    # s 4r "I'm fine, see?"
    s 4r "我好得很，看！"

# script-ch3.rpyc:107
translate chinese ch3_main_fb603655:

    # "Sayori shows me a big smile."
    "纱世里对我绽开一个大大的笑容。"

# script-ch3.rpyc:108
translate chinese ch3_main_599d33ee:

    # s 1a "Don't let me distract you from having fun with everyone."
    s 1a "别让我打扰了你和大家玩的兴致。"

# script-ch3.rpyc:109
translate chinese ch3_main_970c9c1e:

    # mc "Well...alright."
    mc "好……吧。"

# script-ch3.rpyc:110
translate chinese ch3_main_f16c798b:

    # mc "If you say so."
    mc "既然你这么说。"

# script-ch3.rpyc:113
translate chinese ch3_main_1dbe8bfc:

    # "I worriedly glance at Sayori before turning back toward everyone else."
    "我担忧地看了纱世里一眼，才转回大家那边。"

# script-ch3.rpyc:114
translate chinese ch3_main_b6502fc6:

    # "But the conversation has already dispersed, with everyone back at their usual activities."
    "不过谈话早已散了，大家各自回到了日常的活动里。"

# script-ch3.rpyc:115
translate chinese ch3_main_8a136d4b:

    # "Maybe I should ask Monika if she's noticed anything about Sayori recently..."
    "也许我该问问莫妮卡，最近有没有察觉纱世里的异样……"

# script-ch3.rpyc:116
translate chinese ch3_main_c1385105:

    # "Since they've been preparing for the festival, they must be spending a lot of time together."
    "毕竟她们一直在筹备学园祭，相处的时间应该不少。"

# script-ch3.rpyc:117
translate chinese ch3_main_4bfa6536:

    # "I timidly approach Monika, who is shuffling through some papers at her desk."
    "我怯生生地走向正在桌前整理纸张的莫妮卡。"

# script-ch3.rpyc:119
translate chinese ch3_main_2a6e770a:

    # m "[player]! What's up?"
    m "[player]！怎么了？"

# script-ch3.rpyc:120
translate chinese ch3_main_e22411e9:

    # mc "Hey, this might sound a little strange, but..."
    mc "那个，问出来可能有点奇怪……"

# script-ch3.rpyc:121
translate chinese ch3_main_7d89c66d:

    # mc "Have you noticed anything up with Sayori recently?"
    mc "你最近有没有觉得纱世里有什么不对劲？"

# script-ch3.rpyc:122
translate chinese ch3_main_2f38f7c6:

    # m 1d "Anything up with her...?"
    m 1d "哪里不对劲……？"

# script-ch3.rpyc:123
translate chinese ch3_main_6d065c32:

    # m "In what way do you mean?"
    m "你指的是哪方面？"

# script-ch3.rpyc:124
translate chinese ch3_main_4af445be:

    # mc "Maybe I'm reading into it a little too much, but she seems a bit downcast today..."
    mc "可能是我多想了，但她今天好像有点低落……"

# script-ch3.rpyc:125
translate chinese ch3_main_3d2f1e4f:

    # m "Oh? You think so?"
    m "哦？是吗？"

# script-ch3.rpyc:126
translate chinese ch3_main_e65999e3:

    # m "I can't say I've noticed anything about her..."
    m "我倒是没怎么留意到……"

# script-ch3.rpyc:127
translate chinese ch3_main_b0f2d760:

    # "Monika peers across the room at Sayori, who is idly dragging a rubber eraser up and down her desk."
    "莫妮卡朝教室另一头望去——纱世里正心不在焉地用橡皮在桌面上来回蹭着。"

# script-ch3.rpyc:128
translate chinese ch3_main_20f10b9d:

    # m "Maybe there is something on her mind..."
    m "也许她心里确实有事……"

# script-ch3.rpyc:129
translate chinese ch3_main_f53d8414:

    # m 2a "But I'm surprised I'm not the one asking you, [player]."
    m 2a "没想到这话竟不是由我来问你，[player]。"

# script-ch3.rpyc:130
translate chinese ch3_main_4f1d9fcf:

    # m "You certainly know her a lot better than I do."
    m "你可比我要了解她得多。"

# script-ch3.rpyc:131
translate chinese ch3_main_5d1a8e6e:

    # mc "Yeah, but she's never really like this..."
    mc "话是这么说，可她从没这样过……"

# script-ch3.rpyc:132
translate chinese ch3_main_8e93da88:

    # mc "She's always talked to me about things that bothered her."
    mc "以前有什么烦心事，她都会跟我说。"

# script-ch3.rpyc:133
translate chinese ch3_main_41a46d4e:

    # mc "But this time, when I asked her, she was really dismissive."
    mc "可这次我问她，她一副完全不想谈的样子。"

# script-ch3.rpyc:134
translate chinese ch3_main_7806befb:

    # mc "...Sorry, I know it's not your problem!"
    mc "……抱歉，我知道这不关你的事！"

# script-ch3.rpyc:135
translate chinese ch3_main_e84794f0:

    # mc "I just wanted to ask if you knew anything, so I'll drop it now..."
    mc "我就是想问问你知不知道什么，问完我就不提了……"

# script-ch3.rpyc:136
translate chinese ch3_main_9a81ed2c:

    # m 1g "No, no..."
    m 1g "不，不会……"

# script-ch3.rpyc:137
translate chinese ch3_main_1203b368:

    # m "It's important to me, too."
    m "这对我来说也很重要。"

# script-ch3.rpyc:138
translate chinese ch3_main_a44abe16:

    # m 1e "I mean, I'm also friends with her..."
    m 1e "毕竟，我也是她的朋友……"

# script-ch3.rpyc:139
translate chinese ch3_main_4ed92bda:

    # m "And I also care about the well-being of my club members, you know?"
    m "而且我也很在意部员们的状态，你懂的。"

# script-ch3.rpyc:140
translate chinese ch3_main_19a357cd:

    # m 1i "Maybe I'll try talking to her myself..."
    m 1i "也许我该亲自去和她谈谈……"

# script-ch3.rpyc:141
translate chinese ch3_main_86450641:

    # mc "Eh? Are you sure about that...?"
    mc "诶？你确定吗……？"

# script-ch3.rpyc:142
translate chinese ch3_main_8b5282dc:

    # mc "She seemed like she wanted to be left alone..."
    mc "她好像挺想一个人待着的……"

# script-ch3.rpyc:143
translate chinese ch3_main_eeff158c:

    # m "Are you sure?"
    m "你确定吗？"

# script-ch3.rpyc:144
translate chinese ch3_main_d06144a2:

    # m "Maybe she just has a hard time bringing it up with the person of interest..."
    m "也许她只是难以对当事人开口而已……"

# script-ch3.rpyc:145
translate chinese ch3_main_af2414ed:

    # mc "Person of interest...?"
    mc "当事人……？"

# script-ch3.rpyc:146
translate chinese ch3_main_721d4483:

    # mc "What do you mean by that?"
    mc "这话什么意思？"

# script-ch3.rpyc:147
translate chinese ch3_main_a8802558:

    # m 2e "I'm saying that maybe the thing on her mind is you, [player]."
    m 2e "我的意思是，她心里的那个人，也许就是你，[player]。"

# script-ch3.rpyc:148
translate chinese ch3_main_55dcaef8:

    # mc "Me...?"
    mc "我……？"

# script-ch3.rpyc:149
translate chinese ch3_main_f21ed1cb:

    # mc "How on Earth would you come to that conclusion?"
    mc "你怎么会得出这种结论的？"

# script-ch3.rpyc:150
translate chinese ch3_main_3597eef0:

    # m 1j "Well..."
    m 1j "这个嘛……"

# script-ch3.rpyc:151
translate chinese ch3_main_70cf461c:

    # m "I probably shouldn't say too much, but..."
    m "我大概不该说太多，不过……"

# script-ch3.rpyc:152
translate chinese ch3_main_5171073b:

    # m 1a "Sayori talks about you more than anything else, you know?"
    m 1a "纱世里平时聊得最多的，就是你哦。"

# script-ch3.rpyc:153
translate chinese ch3_main_bbe4458e:

    # mc "Eh...?"
    mc "诶……？"

# script-ch3.rpyc:154
translate chinese ch3_main_35841dde:

    # m "She's been so much happier ever since you've joined the club."
    m "自从你加入社团，她比以前开心了好多。"

# script-ch3.rpyc:155
translate chinese ch3_main_d6ca5954:

    # m "It's like an extra light was turned on inside of her."
    m "就像是她心里被点亮了一盏新的灯。"

# script-ch3.rpyc:156
translate chinese ch3_main_11455b53:

    # mc "What?"
    mc "什么？"

# script-ch3.rpyc:157
translate chinese ch3_main_84b7a515:

    # mc "No way..."
    mc "不会吧……"

# script-ch3.rpyc:158
translate chinese ch3_main_f6072126:

    # mc "Sayori...is always like that."
    mc "纱世里……一直都那个样子。"

# script-ch3.rpyc:159
translate chinese ch3_main_25b78605:

    # mc "She's always been full of sunshine."
    mc "她一向都是个充满阳光的人。"

# script-ch3.rpyc:160
translate chinese ch3_main_7a6772a0:

    # mc "It's not any different now than it always has been."
    mc "现在跟以前没什么两样。"

# script-ch3.rpyc:161
translate chinese ch3_main_0ccc6dfb:

    # m 5 "Ehehe."
    m 5 "呵呵。"

# script-ch3.rpyc:162
translate chinese ch3_main_6fa5c5c5:

    # m "You're so funny, [player]."
    m "你真有意思，[player]。"

# script-ch3.rpyc:163
translate chinese ch3_main_ab217aeb:

    # m "Have you thought that maybe you've always seen her as so cheerful..."
    m "你有没有想过——你之所以一直觉得她那么开朗……"

# script-ch3.rpyc:164
translate chinese ch3_main_44e6e308:

    # m "...because that's just how she is when she's around you?"
    m "……只是因为，她在你面前才是那个样子？"

# script-ch3.rpyc:165
translate chinese ch3_main_2b35b6fe:

    # mc "..."
    mc "……"

# script-ch3.rpyc:166
translate chinese ch3_main_f1680e8f:

    # m 1n "Ah...I said too much."
    m 1n "啊……我说得太多了。"

# script-ch3.rpyc:167
translate chinese ch3_main_9cd47824:

    # m "I'm sorry...what do I know, anyway?"
    m "抱歉……反正我又懂什么呢？"

# script-ch3.rpyc:168
translate chinese ch3_main_f2ea8b79:

    # m 1a "I didn't mean to jump to conclusions, so you should just forget about what I said."
    m 1a "我不是想妄下结论，你就把我刚才的话忘掉吧。"

# script-ch3.rpyc:169
translate chinese ch3_main_537af382:

    # m "I'll try to talk to her, so try not to think about it for now."
    m "我会找她谈谈的，你暂时先别多想了。"

# script-ch3.rpyc:170
translate chinese ch3_main_93deaf69:

    # mc "Ah..."
    mc "啊……"

# script-ch3.rpyc:171
translate chinese ch3_main_b12907fb:

    # mc "Alright..."
    mc "好……"

# script-ch3.rpyc:172
translate chinese ch3_main_43c1f1cb:

    # "Monika smiles meaningfully."
    "莫妮卡意味深长地笑了。"

# script-ch3.rpyc:173
translate chinese ch3_main_4fe59b5e:

    # "I know she said to forget about it..."
    "她虽说让我忘掉……"

# script-ch3.rpyc:174
translate chinese ch3_main_fffb9c28:

    # "But I already know that I won't be able to get her words out of my head."
    "但我很清楚，那些话已经在脑中挥之不去了。"

# script-ch3.rpyc:177
translate chinese ch3_main_b789063e:

    # "Monika stands up from her desk and walks across the room to where Sayori is sitting."
    "莫妮卡从座位上起身，穿过教室走向纱世里。"

# script-ch3.rpyc:178
translate chinese ch3_main_7b6cf640:

    # "I watch her kneel down next to Sayori and gently talk to her."
    "我看着她跪坐在纱世里身旁，轻声与她交谈。"

# script-ch3.rpyc:179
translate chinese ch3_main_e970c9da:

    # "But she's keeping her voice so quiet that I can't hear her from here."
    "只是她的声音压得太低，我在这里什么也听不见。"

# script-ch3.rpyc:180
translate chinese ch3_main_28bcbf2a:

    # "I sigh and sit myself down."
    "我叹了口气，坐了下来。"

# script-ch3.rpyc:181
translate chinese ch3_main_69bc17e9:

    # "I know Sayori told me not to worry about her, and to have fun with everyone else..."
    "纱世里让我别担心她，去和大家一起玩……"

# script-ch3.rpyc:182
translate chinese ch3_main_4890308f:

    # "But that's impossible to do when she's behaving like this."
    "可她这副样子，我怎么可能做得到。"

# script-ch3.rpyc:183
translate chinese ch3_main_fae0adaf:

    # "Exactly how much do I care about her, that I'm letting this weigh me down so much?"
    "我究竟是有多在乎她，才会被这件事压得喘不过气？"

# script-ch3.rpyc:184
translate chinese ch3_main_15fb5d0a:

    # "Now it feels like I'm the one behaving out of the ordinary..."
    "现在反倒是我的举止变得不正常了……"

# script-ch3.rpyc:185
translate chinese ch3_main_9fca3f68:

    # "But there's nothing I can do besides wait for Monika."
    "除了等莫妮卡，我什么也做不了。"

# script-ch3.rpyc:211
translate chinese ch3_start_natsuki_902551ba:

    # n "Hey, you."
    n "喂，说你呢。"

# script-ch3.rpyc:212
translate chinese ch3_start_natsuki_fb2e5377:

    # mc "Eh?"
    mc "诶？"

# script-ch3.rpyc:213
translate chinese ch3_start_natsuki_e73b3f96:

    # "I look up to see Natsuki next to me."
    "我抬起头，夏树站在我身边。"

# script-ch3.rpyc:214
translate chinese ch3_start_natsuki_f4523236:

    # n "Are you just gonna sit there and keep staring at nothing?"
    n "你打算就这么坐着，一直对着空气发呆？"

# script-ch3.rpyc:215
translate chinese ch3_start_natsuki_8fba89af:

    # n "There isn't that much time, so..."
    n "时间可不多，所以……"

# script-ch3.rpyc:216
translate chinese ch3_start_natsuki_ad9d747e:

    # mc "Ah, sorry."
    mc "啊，抱歉。"

# script-ch3.rpyc:217
translate chinese ch3_start_natsuki_f930e5b1:

    # mc "I didn't mean to make you worry or anything."
    mc "我不是故意让你担心的。"

# script-ch3.rpyc:218
translate chinese ch3_start_natsuki_030f9150:

    # n 1q "I-It's not like I'm worried!"
    n 1q "才、才没有担心你！"

# script-ch3.rpyc:219
translate chinese ch3_start_natsuki_9aff6292:

    # n "I was just..."
    n "我只是……"

# script-ch3.rpyc:220
translate chinese ch3_start_natsuki_a41a98d6:

    # "Natsuki glances down at her side."
    "夏树低头瞥了一眼手边。"

# script-ch3.rpyc:221
translate chinese ch3_start_natsuki_212a86e2:

    # "She's holding a volume of manga in her hand."
    "她手里拿着一册漫画。"

# script-ch3.rpyc:222
translate chinese ch3_start_natsuki_dad7a8db:

    # mc "That's right..."
    mc "对了……"

# script-ch3.rpyc:223
translate chinese ch3_start_natsuki_d24ec9fb:

    # mc "Something just came up for a minute, but we can get started now."
    mc "刚才只是有点事，现在可以开始了。"

# script-ch3.rpyc:224
translate chinese ch3_start_natsuki_96ad46f7:

    # mc "I won't make you wait any longer."
    mc "不让你多等了。"

# script-ch3.rpyc:225
translate chinese ch3_start_natsuki_8a80dfb5:

    # n 5n "Jeez..."
    n 5n "真是的……"

# script-ch3.rpyc:226
translate chinese ch3_start_natsuki_3550bb95:

    # n "Now you're making me feel like a jerk."
    n "你这样搞得我倒像坏人了。"

# script-ch3.rpyc:227
translate chinese ch3_start_natsuki_607cf66c:

    # n "If something's bothering you, then you can just tell me to leave you alone, and I will."
    n "你要是有什么烦心事，直接叫我别烦你就行了，我立马走。"

# script-ch3.rpyc:228
translate chinese ch3_start_natsuki_9a59920b:

    # n 5u "I mean..."
    n 5u "就是说……"

# script-ch3.rpyc:229
translate chinese ch3_start_natsuki_f42f6ca7:

    # n "Assuming you didn't feel like talking about it or anything..."
    n "假如说你不想谈的话……"

# script-ch3.rpyc:230
translate chinese ch3_start_natsuki_eb708455:

    # "She practically mumbles that last part."
    "最后半句她几乎是从牙缝里嘟囔出来的。"

# script-ch3.rpyc:231
translate chinese ch3_start_natsuki_82c21d4c:

    # mc "Nah...I'm probably making it seem like a bigger deal than it is."
    mc "没有……可能是我把事情弄得比实际更严重了。"

# script-ch3.rpyc:232
translate chinese ch3_start_natsuki_39a60b69:

    # mc "I've just been thinking about Sayori, that's all."
    mc "我只是在想纱世里的事而已。"

# script-ch3.rpyc:233
translate chinese ch3_start_natsuki_3d513601:

    # n 1p "S-Sayori...?"
    n 1p "纱、纱世里……？"

# script-ch3.rpyc:234
translate chinese ch3_start_natsuki_cddb30dc:

    # n "Thinking about her...?"
    n "想她的事……？"

# script-ch3.rpyc:235
translate chinese ch3_start_natsuki_f7dbd999:

    # mc "Yeah, she seems pretty down today."
    mc "嗯，她今天看起来很低落。"

# script-ch3.rpyc:236
translate chinese ch3_start_natsuki_588008e2:

    # mc "But she didn't want to admit it to me."
    mc "可她不想在我面前承认。"

# script-ch3.rpyc:237
translate chinese ch3_start_natsuki_5ccf3d8c:

    # mc "So I can't help but wonder if something happened to her."
    mc "所以我不禁琢磨，她是不是出了什么事。"

# script-ch3.rpyc:238
translate chinese ch3_start_natsuki_76502d6d:

    # n 1q "Oh..."
    n 1q "哦……"

# script-ch3.rpyc:239
