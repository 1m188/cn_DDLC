    # mc "Eh...?"
    mc "诶……？"

# script-ch3.rpyc:317
translate chinese ch3_start_yuri_a272b51c:

    # y 4c "S-Sorry!"
    y 4c "对、对不起！"

# script-ch3.rpyc:318
translate chinese ch3_start_yuri_cb06f6f8:

    # y "I didn't mean to say something stupid...!"
    y "我不是故意说蠢话的……！"

# script-ch3.rpyc:319
translate chinese ch3_start_yuri_f39335e9:

    # mc "It's not that, I just didn't want you to misunderstand."
    mc "倒不是那个意思，我只是不想让你误会。"

# script-ch3.rpyc:320
translate chinese ch3_start_yuri_df68ee98:

    # mc "Sayori and I have just been friends for a long time, that's all."
    mc "我和纱世里只是认识了很久的朋友，仅此而已。"

