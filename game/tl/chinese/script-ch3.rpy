# script-ch3.rpyc:1151
translate chinese ch3_end_yuri_a22f1a9b:

    # y "I think that we'll make a very productive team."
    y "我觉得，我们会是一对效率极高的搭档。"

# script-ch3.rpyc:1152
translate chinese ch3_end_yuri_54114af3:

    # y 1u "Even if you only chose me because you felt bad or something..."
    y 1u "就算你只是出于愧疚才选的我……"

# script-ch3.rpyc:1153
translate chinese ch3_end_yuri_5973a68a:

    # mc "Wait...!"
    mc "等等……！"

# script-ch3.rpyc:1154
translate chinese ch3_end_yuri_247501df:

    # mc "You don't actually think that, do you?"
    mc "你不会真这么想吧？"

# script-ch3.rpyc:1155
translate chinese ch3_end_yuri_0dbaabdd:

    # y 4b "..."
    y 4b "……"

# script-ch3.rpyc:1156
translate chinese ch3_end_yuri_48f5cc95:

    # y "I...don't know."
    y "我……不知道。"

# script-ch3.rpyc:1157
translate chinese ch3_end_yuri_924431d9:

    # y "It's difficult to come up with any other reason you may have chosen me..."
    y "除了这个，我想不出你选我的其他理由……"

# script-ch3.rpyc:1158
translate chinese ch3_end_yuri_d8a3a07b:

    # mc "You're forgetting the one reason with the most common sense!"
    mc "你忘了最合乎常理的那个理由了！"

# script-ch3.rpyc:1159
translate chinese ch3_end_yuri_0c409d3f:

    # mc "I chose to help you because that's what I want to do."
    mc "我选你，是因为我想帮你。"

# script-ch3.rpyc:1160
translate chinese ch3_end_yuri_4568f8ee:

    # y 2v "B-But..."
    y 2v "可、可是……"

# script-ch3.rpyc:1161
translate chinese ch3_end_yuri_84bc3d23:

    # "Yuri thinks to herself with an extremely tense expression."
    "优里神情极度紧张地思忖着。"

# script-ch3.rpyc:1162
translate chinese ch3_end_yuri_0b42cf34:

    # mc "Yuri...you're overthinking this."
    mc "优里……你想多了。"

# script-ch3.rpyc:1163
translate chinese ch3_end_yuri_40033046:

    # mc "You wanted me to point out when you're overthinking, right?"
    mc "你说过，想让我在你多想的时候提醒你，对吧？"

# script-ch3.rpyc:1164
translate chinese ch3_end_yuri_d1820aca:

    # y "Eh...?"
    y "诶……？"

# script-ch3.rpyc:1165
translate chinese ch3_end_yuri_3d2e38f5:

    # y 4 "I...didn't realize..."
    y 4 "我……都没发现……"

# script-ch3.rpyc:1166
translate chinese ch3_end_yuri_3158a610:

    # mc "I'm telling you, I want to."
    mc "我告诉你，我是自愿的。"

# script-ch3.rpyc:1167
translate chinese ch3_end_yuri_7584c8de:

    # mc "That's all there is to it."
    mc "就这么简单。"

# script-ch3.rpyc:1168
translate chinese ch3_end_yuri_cfe6e6b7:

    # mc "Do you believe me?"
    mc "你信我吗？"

# script-ch3.rpyc:1169
translate chinese ch3_end_yuri_b4a282c8:

    # y 1t "I..."
    y 1t "我……"

# script-ch3.rpyc:1170
translate chinese ch3_end_yuri_c1b1352a:

    # "Yuri thinks really hard again."
    "优里又开始拼命思索。"

# script-ch3.rpyc:1171
translate chinese ch3_end_yuri_91d334e6:

    # "She looks straight into my eyes for a long while."
    "她久久地直视着我的眼睛。"

# script-ch3.rpyc:1172
translate chinese ch3_end_yuri_7f627e4a:

    # y 3l "...I believe you!"
    y 3l "……我相信你！"

# script-ch3.rpyc:1173
translate chinese ch3_end_yuri_0ace9a63:

    # "As if it took her tremendous effort, Yuri finally says that and relaxes her expression."
    "仿佛费尽了全身力气，优里终于说出这句话，神情也放松下来。"

# script-ch3.rpyc:1174
translate chinese ch3_end_yuri_83916e61:

    # y 3s "And I'm really looking forward to Sunday."
    y 3s "我真的，很期待周日。"

# script-ch3.rpyc:1175
translate chinese ch3_end_yuri_69c25b65:

    # mc "Yeah..."
    mc "嗯……"

# script-ch3.rpyc:1176
translate chinese ch3_end_yuri_1c6fc136:

    # mc "I am too."
    mc "我也是。"

# script-ch3.rpyc:1179
translate chinese ch3_end_yuri_330007c6:

    # "After that exchange, I make my way out the door, and Yuri follows."
    "这番对话之后，我走出了活动室，优里跟在后面。"

translate chinese strings:

    # script-ch3.rpy:630
    old "But of course, I'm going to go with--"
    new "那当然，我要选的是——"

    # script-ch3.rpy:630
    old "Monika."
    new "莫妮卡。"

    # script-ch3.rpy:630
    old "Sayori..."
    new "纱世里……"
