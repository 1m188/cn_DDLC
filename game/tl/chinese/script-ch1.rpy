# script-ch1.rpyc:9
translate chinese ch1_main_0f077782:

    # m "Hi again, [player]!"
    m "又见面啦，[player]！"

# script-ch1.rpyc:10
translate chinese ch1_main_95ea4bac:

    # m "Glad to see you didn't run away on us. Hahaha!"
    m "真高兴你没有临阵脱逃。哈哈哈！"

# script-ch1.rpyc:11
translate chinese ch1_main_ecaf5654:

    # mc "Nah, don't worry."
    mc "没有啦，别担心。"

# script-ch1.rpyc:12
translate chinese ch1_main_a0e98f5a:

    # mc "This might be a little strange for me, but I at least keep my word."
    mc "这对我来说是有点不习惯，但好歹我说到做到。"

# script-ch1.rpyc:15
translate chinese ch1_main_5bff8fb6:

    # "Well, I'm back at the Literature Club."
    "就这样，我又来到了文学部。"

# script-ch1.rpyc:16
translate chinese ch1_main_0565e928:

    # "I was the last to come in, so everyone else is already hanging out."
    "我最后一个到，其他人都已经各自聚着聊天了。"

# script-ch1.rpyc:18
translate chinese ch1_main_209577b0:

    # y "Thanks for keeping your promise, [player]."
    y "谢谢你信守承诺，[player]。"

# script-ch1.rpyc:19
translate chinese ch1_main_fc35d1a5:

    # y "I hope this isn't too overwhelming of a commitment for you."
    y "希望这对你来说不算太沉重的负担。"

# script-ch1.rpyc:20
translate chinese ch1_main_0b033aa0:

    # y 1u "Making you dive headfirst into literature when you're not accustomed to it..."
    y 1u "让你在还不习惯的情况下，一头扎进文学的世界……"

# script-ch1.rpyc:22
translate chinese ch1_main_4bc8df14:

    # n "Oh, come on! Like he deserves any slack."
    n "拜托！可别对他太宽容了。"

# script-ch1.rpyc:23
translate chinese ch1_main_54887548:

    # n "Sayori told me you didn't even want to join any clubs this year."
    n "纱世里跟我说过，你今年压根就不想参加什么社团。"

# script-ch1.rpyc:24
translate chinese ch1_main_0e4e14ce:

    # n "And last year, too!"
    n "去年也是！"

# script-ch1.rpyc:25
translate chinese ch1_main_131e8e4b:

    # n 4c "I don't know if you plan to just come here and hang out, or what..."
    n 4c "我不知道你是打算来这儿混日子，还是怎么样……"

# script-ch1.rpyc:26
translate chinese ch1_main_8ef8abd3:

    # n "But if you don't take us seriously, then you won't see the end of it."
    n "但你要是不拿出认真的态度来，我可不轻饶你。"

# script-ch1.rpyc:28
translate chinese ch1_main_e8cad960:

    # m "Natsuki, you certainly have a big mouth for someone who keeps her manga collection in the clubroom."
    m "夏树，把自己收藏的漫画放在活动室里的人，说话倒是挺不客气的嘛。"

# script-ch1.rpyc:29
translate chinese ch1_main_28526ae4:

    # n 4o "M-M-M...!!"
    n 4o "漫、漫……！！"

# script-ch1.rpyc:32
translate chinese ch1_main_6ff88347:

    # "Natsuki finds herself stuck between saying \"Monika\" and \"Manga\"."
    "夏树卡在了“莫妮卡”和“漫画”之间，不知该先反驳哪个。"

# script-ch1.rpyc:34
translate chinese ch1_main_8e1ee84b:

    # n 1v "Manga is literature!!"
    n 1v "漫画也是文学！！"

# script-ch1.rpyc:37
translate chinese ch1_main_036357ba:

    # "Swiftly defeated, Natsuki plops back into her seat."
    "被迅速击败的夏树一屁股坐回了椅子上。"

# script-ch1.rpyc:40
translate chinese ch1_main_a84b9413:

    # s "Don't worry, guys~"
    s "别担心啦，各位~"

# script-ch1.rpyc:41
translate chinese ch1_main_d7cf9956:

    # s "[player] always gives it his best as long as he's having fun."
    s "[player]只要玩得开心，就会全力以赴的。"

# script-ch1.rpyc:42
translate chinese ch1_main_f466355f:

    # s "He helps me with busywork without me even asking."
    s "我不用开口，他就会帮我做杂事。"

# script-ch1.rpyc:43
translate chinese ch1_main_13c9b95d:

    # s "Like cooking, cleaning my room..."
    s "像是做饭啊、打扫房间什么的……"

# script-ch1.rpyc:46
translate chinese ch1_main_6c9290b7:

    # y 2m "How dependable..."
    y 2m "真可靠啊……"

# script-ch1.rpyc:48
translate chinese ch1_main_01768f1a:

    # mc "Sayori, that's because your room is so messy it's distracting."
    mc "纱世里，那是因为你的房间乱得让人看不下去。"

# script-ch1.rpyc:49
translate chinese ch1_main_f03a36de:

    # mc "And you almost set your house on fire once."
    mc "而且你有一次还差点把房子点了。"

# script-ch1.rpyc:51
translate chinese ch1_main_46619abb:

    # s 5 "Is that so... Ehehe..."
    s 5 "是吗……诶嘿嘿……"

# script-ch1.rpyc:53
translate chinese ch1_main_e3d60137:

    # y 1s "You two are really good friends, aren't you?"
    y 1s "你们俩真是要好的朋友呢。"

# script-ch1.rpyc:54
translate chinese ch1_main_5150f59d:

    # y "I might be a little jealous..."
    y "我或许还有点羡慕……"

# script-ch1.rpyc:57
translate chinese ch1_main_b7fd516c:

    # s 1 "How come? You and [player] can become good friends too!"
    s 1 "为什么呀？你和[player]也可以成为好朋友的！"

# script-ch1.rpyc:60
translate chinese ch1_main_6897629e:

    # y 4b "U-Um..."
    y 4b "唔、唔……"

# script-ch1.rpyc:62
translate chinese ch1_main_7b7e4806:

    # mc "S-Sayori--"
    mc "纱、纱世里——"

# script-ch1.rpyc:64
translate chinese ch1_main_cb503a81:

    # s "Hmm?"
    s "嗯？"

# script-ch1.rpyc:66
translate chinese ch1_main_2b35b6fe:

    # mc "..."
    mc "……"

# script-ch1.rpyc:67
translate chinese ch1_main_ba3de90d:

    # "As usual, Sayori seems oblivious to the weird situation she just put me into."
    "和往常一样，纱世里似乎完全没意识到自己刚把我推进了怎样的尴尬境地。"

# script-ch1.rpyc:69
translate chinese ch1_main_f55ccd4d:

    # s 4x "Oh, oh! Yuri even brought you something today, you know~"
    s 4x "对了对了！优里今天还给你带了东西哦~"

# script-ch1.rpyc:72
translate chinese ch1_main_ea01e1e9:

    # y 3n "W-Wait! Sayori..."
    y 3n "等、等等！纱世里……"

# script-ch1.rpyc:74
translate chinese ch1_main_5f167be7:

    # mc "Eh? Me?"
    mc "诶？我吗？"

# script-ch1.rpyc:76
translate chinese ch1_main_919bbc2a:

    # y 3o "Um... Not really..."
    y 3o "那个……其实也没什么……"

# script-ch1.rpyc:79
translate chinese ch1_main_828bb88b:

    # s 4r "Don't be shy~"
    s 4r "别害羞嘛~"

# script-ch1.rpyc:82
translate chinese ch1_main_05eb3e49:

    # y "It's really nothing..."
    y "真的没什么大不了的……"

# script-ch1.rpyc:84
translate chinese ch1_main_def0ad19:

    # mc "What is it?"
    mc "是什么呀？"

# script-ch1.rpyc:86
translate chinese ch1_main_637268ae:

    # y 4c "N-Never mind!"
    y 4c "算、算了吧！"

# script-ch1.rpyc:87
translate chinese ch1_main_cb7eb154:

    # y "Sayori made it sound like a big deal when it's really not..."
    y "纱世里把它说得像多了不起的大事似的，其实根本不是……"

# script-ch1.rpyc:88
translate chinese ch1_main_d9e54b67:

    # y "Uuuuh, what do I do..."
    y "呜呜，这可怎么办……"

# script-ch1.rpyc:91
translate chinese ch1_main_2224ad48:

    # s 1g "Eh? I'm sorry, Yuri, I wasn't thinking..."
    s 1g "诶？对不起，优里，我没有多想……"

# script-ch1.rpyc:95
translate chinese ch1_main_9ff3c337:

    # "I guess that means it's up to me to rescue this situation..."
    "看来这个场面只能由我来救了……"

# script-ch1.rpyc:96
translate chinese ch1_main_6f06b205:

    # mc "Hey, don't worry about it."
    mc "喂，别放在心上。"

# script-ch1.rpyc:97
translate chinese ch1_main_04495733:

    # mc "First of all, I wasn't expecting anything in the first place."
    mc "首先，我本来就没有期待要收到什么。"

# script-ch1.rpyc:98
translate chinese ch1_main_c8eaf1f5:

    # mc "So any nice gesture from you is a pleasant surprise."
    mc "所以你的任何心意，对我来说都是意外的惊喜。"

# script-ch1.rpyc:99
translate chinese ch1_main_22fbe112:

    # mc "It'll make me happy no matter what."
    mc "不管是什么，我都会很开心的。"

# script-ch1.rpyc:100
translate chinese ch1_main_a1560f15:

    # y 3v "I-Is that so..."
    y 3v "是、是这样吗……"

# script-ch1.rpyc:101
translate chinese ch1_main_d86fe35f:

    # mc "Yeah. I won't make it a big deal if you don't want it to be."
    mc "嗯。如果你不想小题大做，那我就当它是件小事。"

# script-ch1.rpyc:102
translate chinese ch1_main_6e92cc87:

    # y "Alright..."
    y "那好吧……"

# script-ch1.rpyc:103
translate chinese ch1_main_f4383968:

    # y 1a "Well, here."
    y 1a "那么，给。"

# script-ch1.rpyc:104
translate chinese ch1_main_5c6d9095:

    # "Yuri reaches into her bag and pulls out a book."
    "优里把手伸进书包，取出一本书。"

# script-ch1.rpyc:105
translate chinese ch1_main_394a6121:

    # y "I didn't want you to feel left out..."
    y "我不想让你觉得自己被冷落了……"

# script-ch1.rpyc:106
translate chinese ch1_main_1879c00c:

    # y "So I picked out a book that I thought you might enjoy."
    y "所以挑了一本我觉得你也许会喜欢的书。"

# script-ch1.rpyc:107
translate chinese ch1_main_c76bcbd9:

    # y "It's a short read, so it should keep your attention, even if you don't usually read."
    y "篇幅不长，就算你不常读书，也应该能读得进去。"

# script-ch1.rpyc:108
translate chinese ch1_main_1c1fa68f:

    # y "And we could, you know..."
    y "而且我们可以……你懂的……"

# script-ch1.rpyc:110
translate chinese ch1_main_262616a0:

    # y 4b "Discuss it...if you wanted..."
    y 4b "一起讨论……如果你愿意的话……"

# script-ch1.rpyc:111
translate chinese ch1_main_257a5a4c:

    # "Th-This is..."
    "这、这是……"

# script-ch1.rpyc:112
translate chinese ch1_main_dbd79240:

    # "How is this girl accidentally being so cute?"
    "这女孩怎么会无意间这么可爱？"

# script-ch1.rpyc:113
translate chinese ch1_main_067cb0c1:

    # "She even picked out a book she thinks I'll like, despite me not reading much..."
    "明明知道我不怎么读书，她还特意挑了一本觉得我会喜欢的……"

# script-ch1.rpyc:114
translate chinese ch1_main_063782d3:

    # mc "Yuri, thank you! I'll definitely read this!"
    mc "优里，谢谢你！我一定会读的！"

# script-ch1.rpyc:115
translate chinese ch1_main_a0d526be:

    # "I enthusiastically take the book."
    "我满怀热情地接过了书。"

# script-ch1.rpyc:117
translate chinese ch1_main_f6554ff6:

    # y "Phew..."
    y "呼……"

# script-ch1.rpyc:118
translate chinese ch1_main_3b5e8d6c:

    # y 2a "Well, you can read it at your own pace."
    y 2a "你可以按自己的节奏慢慢读。"

# script-ch1.rpyc:119
translate chinese ch1_main_17c99d12:

    # y "I look forward to hearing what you think."
    y "期待听听你的感想。"

# script-ch1.rpyc:124
translate chinese ch1_main_5d35cc1a:

    # "Now that everyone's settled in, I expected Monika to kick off some scheduled activities for the club."
    "待大家都落座后，我以为莫妮卡会宣布部活的既定安排。"

# script-ch1.rpyc:125
translate chinese ch1_main_be0f213d:

    # "But that doesn't seem to be the case."
    "但似乎并不是这样。"

# script-ch1.rpyc:126
translate chinese ch1_main_f081c8d6:

    # "Sayori and Monika are having a cheery conversation in the corner."
    "纱世里和莫妮卡正在角落里兴致勃勃地聊天。"

# script-ch1.rpyc:127
translate chinese ch1_main_301982d1:

    # "Yuri's face is already buried in a book."
    "优里已经埋头读起了书。"

# script-ch1.rpyc:128
translate chinese ch1_main_b18fd321:

    # "I can't help but notice her intense expression, like she was waiting for this chance."
    "我不由得注意到她专注的神情，仿佛一直在等待这个机会。"

# script-ch1.rpyc:129
translate chinese ch1_main_6713a333:

    # "Meanwhile, Natsuki is rummaging around in the closet."
    "另一边，夏树正在柜子里翻找着什么。"

# script-ch1.rpyc:140
translate chinese ch1_main_25d7e7ce:

    # m "By the way, did you remember to write a poem last night?"
    m "对了，昨晚的诗你写了吗？"

# script-ch1.rpyc:141
translate chinese ch1_main_5aa72ccd:

    # mc "Y-Yeah..."
    mc "写、写了……"

# script-ch1.rpyc:142
translate chinese ch1_main_b8d87d90:

    # "My relaxation ends."
    "我的悠闲时光到此结束。"

# script-ch1.rpyc:143
translate chinese ch1_main_070e9df2:

    # "I can't believe I agreed to do something so embarrassing."
    "真不敢相信我居然答应了这么难为情的事。"

# script-ch1.rpyc:144
translate chinese ch1_main_0b915520:

    # "I couldn't really find much inspiration, since I've never really done this before."
    "我从来没写过诗，实在找不到什么灵感。"

# script-ch1.rpyc:145
translate chinese ch1_main_96a5a5c4:

    # m "Well, now that everyone's ready, why don't you find someone to share with?"
    m "那么，既然大家都准备好了，就找个人互相分享吧？"

# script-ch1.rpyc:147
translate chinese ch1_main_ebf4c7a9:

    # s "I can't wait~!"
    s "人家等不及啦~！"

# script-ch1.rpyc:152
translate chinese ch1_main_65e6fcbd:

    # "Sayori and Monika enthusiastically pull out their poems."
    "纱世里和莫妮卡干劲十足地拿出各自的诗。"

# script-ch1.rpyc:153
translate chinese ch1_main_b87d3078:

    # "Sayori's is on a wrinkled sheet of loose leaf torn from a spiral notebook."
    "纱世里的诗写在一张从活页本上撕下来的、皱巴巴的纸上。"

# script-ch1.rpyc:154
translate chinese ch1_main_ccd4f660:

    # "On the other hand, Monika wrote hers in a composition notebook."
    "而莫妮卡的诗则工工整整地写在笔记本上。"

# script-ch1.rpyc:155
translate chinese ch1_main_a3b175bf:

    # "I can already see Monika's pristine handwriting from where I sit."
    "隔着老远，我就能看见莫妮卡那漂亮的字迹。"

# script-ch1.rpyc:156
translate chinese ch1_main_7354e005:

    # "Natsuki and Yuri reluctantly comply as well, reaching into their bags."
    "夏树和优里也心不甘情不愿地伸手进书包，拿出了自己的诗。"

# script-ch1.rpyc:157
translate chinese ch1_main_5bc5f049:

    # "I do the same, myself."
    "我也同样拿了出来。"

# script-ch1.rpyc:167
translate chinese ch1_end_d91458f0:

    # mc "Phew..."
    mc "呼……"

# script-ch1.rpyc:168
translate chinese ch1_end_1782371d:

    # "I guess that's everyone."
    "应该都分享完了吧。"

# script-ch1.rpyc:169
translate chinese ch1_end_58e4d71b:

    # "I glance around the room."
    "我环视了一圈活动室。"

# script-ch1.rpyc:170
translate chinese ch1_end_21f37dea:

    # "That was a little more stressful than I anticipated."
    "这可比我想象的还要累人一些。"

# script-ch1.rpyc:171
translate chinese ch1_end_5b12ad4c:

    # "It's as if everyone is judging me for my mediocre writing abilities..."
    "仿佛所有人都在审视我这平庸的文笔……"

# script-ch1.rpyc:172
translate chinese ch1_end_72e6b5de:

    # "Even if they're just being nice, there's no way my poems can stand up to theirs."
    "就算她们只是出于好心，我的诗也绝对比不过她们的。"

# script-ch1.rpyc:173
translate chinese ch1_end_3e6d2aa1:

    # "This is a literature club, after all."
    "这里毕竟是文学部啊。"

# script-ch1.rpyc:174
translate chinese ch1_end_3f739ce1:

    # "I sigh."
    "我叹了口气。"

# script-ch1.rpyc:175
translate chinese ch1_end_e55af38e:

    # "I guess that's what I ended up getting myself into."
    "看来我就是自作自受吧。"

# script-ch1.rpyc:176
translate chinese ch1_end_21c3ee10:

    # "Across the room, Sayori and Monika are happily chatting."
    "活动室另一头，纱世里和莫妮卡正聊得开心。"

# script-ch1.rpyc:177
translate chinese ch1_end_841184ee:

    # "My eyes land on Yuri and Natsuki."
    "我的目光落在了优里和夏树身上。"

# script-ch1.rpyc:180
translate chinese ch1_end_1705c9fe:

    # "They gingerly exchange sheets of paper, sharing their respective poems."
    "她们小心翼翼地交换纸页，分享着彼此的诗。"

# script-ch1.rpyc:182
translate chinese ch1_end_37b74d39:

    # "As they read in tandem, I watch each of their expressions change."
    "她们同时读着对方的诗，我在一旁观察着两人神情的变化。"

# script-ch1.rpyc:183
translate chinese ch1_end_f3def454:

    # "Natsuki's eyebrows furrow in frustration."
    "夏树的眉头不满地皱了起来。"

# script-ch1.rpyc:184
translate chinese ch1_end_1583e001:

    # "Meanwhile, Yuri smiles sadly."
    "而优里则露出了落寞的微笑。"

# script-ch1.rpyc:186
translate chinese ch1_end_36ce7fb5:

    # n 1q "{i}(What's with this language...?){/i}"
    n 1q "{i}（这用词也太……？）{/i}"

# script-ch1.rpyc:189
translate chinese ch1_end_5f1028e8:

    # y 2f "Eh?"
    y 2f "诶？"

# script-ch1.rpyc:190
translate chinese ch1_end_392e3f64:

    # y "Um...did you say something?"
    y "那个……你说什么了吗？"

# script-ch1.rpyc:193
translate chinese ch1_end_5a23a338:

    # n 2c "Oh, it's nothing."
    n 2c "哦，没什么。"

# script-ch1.rpyc:194
translate chinese ch1_end_73b87d84:

    # "Natsuki dismissively returns the poem to the desk with one hand."
    "夏树漫不经心地单手把诗放回桌上。"

# script-ch1.rpyc:195
translate chinese ch1_end_678d666c:

    # n "I guess you could say it's fancy."
    n "要我说的话，算是有格调吧。"

# script-ch1.rpyc:198
translate chinese ch1_end_ee8faee5:

    # y 2i "Ah-- Thanks..."
    y 2i "啊——谢谢……"

# script-ch1.rpyc:199
translate chinese ch1_end_1705b12d:

    # y "Yours is...cute..."
    y "你的诗……很可爱……"

# script-ch1.rpyc:202
translate chinese ch1_end_d53cb64f:

    # n 2h "Cute?"
    n 2h "可爱？"

# script-ch1.rpyc:203
translate chinese ch1_end_d7a2229c:

    # n 1h "Did you completely miss the symbolism or something?"
    n 1h "你是完全没看懂里面的象征意义吗？"

# script-ch1.rpyc:204
translate chinese ch1_end_a5b7430f:

    # n "It's clearly about the feeling of giving up."
    n "这明显写的是放弃的心情。"

# script-ch1.rpyc:205
translate chinese ch1_end_0db745ab:

    # n "How can that be cute?"
    n "那种东西哪里可爱了？"

# script-ch1.rpyc:208
translate chinese ch1_end_d42c351b:

    # y 3f "I-I know that!"
    y 3f "我、我知道啦！"

# script-ch1.rpyc:209
translate chinese ch1_end_b698ba3b:

    # y "I just meant..."
    y "我只是想说……"

