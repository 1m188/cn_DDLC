    "优里取出茶壶，开始称量茶叶。"

# script-exclusives2-yuri.rpyc:415
translate chinese yuri_exclusive2_2_ch22_b78eae4f:

    # "To my surprise, she even starts humming a little to herself."
    "出乎我意料的是，她甚至开始轻声哼起歌来。"

# script-exclusives2-yuri.rpyc:417
translate chinese yuri_exclusive2_2_ch22_ba599efa:

    # mc "You must be in a good mood now..."
    mc "你心情不错嘛……"

# script-exclusives2-yuri.rpyc:418
translate chinese yuri_exclusive2_2_ch22_c32eedbb:

    # y 1a "Is that so?"
    y 1a "是吗？"

# script-exclusives2-yuri.rpyc:419
translate chinese yuri_exclusive2_2_ch22_ab893d32:

    # y "I was letting it show..."
    y "我不小心表现出来了……"

# script-exclusives2-yuri.rpyc:420
translate chinese yuri_exclusive2_2_ch22_7f41b19f:

    # y "And you noticed."
    y "而你看出来了。"

# script-exclusives2-yuri.rpyc:421
translate chinese yuri_exclusive2_2_ch22_bca12f15:

    # y 2u "I was doing a bit of thinking..."
    y 2u "我刚才想了一些事……"

# script-exclusives2-yuri.rpyc:422
translate chinese yuri_exclusive2_2_ch22_0164772c:

    # y "And I decided that I would try expressing myself a little bit more."
    y "然后决定试着多表达一点自己。"

# script-exclusives2-yuri.rpyc:423
translate chinese yuri_exclusive2_2_ch22_b699d4da:

    # y "It turns out it's not very hard for me to do..."
    y "结果发现，对我来说并不难……"

# script-exclusives2-yuri.rpyc:424
translate chinese yuri_exclusive2_2_ch22_c52c4a97:

    # y 1c "When it's you who's around, anyway."
    y 1c "至少，当身边的人是你的时候。"

# script-exclusives2-yuri.rpyc:426
translate chinese yuri_exclusive2_2_ch22_93deaf69:

    # mc "Ah..."
    mc "啊……"

# script-exclusives2-yuri.rpyc:427
translate chinese yuri_exclusive2_2_ch22_1c90c29a:

    # mc "That's great, Yuri!"
    mc "那太好了，优里！"

# script-exclusives2-yuri.rpyc:428
translate chinese yuri_exclusive2_2_ch22_28e6d662:

    # mc "Just don't push yourself too much."
    mc "只是别太勉强自己。"

# script-exclusives2-yuri.rpyc:429
translate chinese yuri_exclusive2_2_ch22_5aab8dd2:

    # y 3u "You're always worrying about me, [player]..."
    y 3u "你总是在担心我呢，[player]……"

# script-exclusives2-yuri.rpyc:430
translate chinese yuri_exclusive2_2_ch22_6f88fe35:

    # y "It's very endearing."
    y "真让人暖心。"

# script-exclusives2-yuri.rpyc:431
translate chinese yuri_exclusive2_2_ch22_b7f7559b:

    # mc "That's..."
    mc "那是……"

# script-exclusives2-yuri.rpyc:432
translate chinese yuri_exclusive2_2_ch22_04ca9dc1:

    # "Yuri wasn't kidding..."
    "优里还真不是说笑……"

# script-exclusives2-yuri.rpyc:433
translate chinese yuri_exclusive2_2_ch22_7604063e:

    # "I don't even know if I can keep up with this...!"
    "我都不知道自己跟不跟得上这种节奏……！"

# script-exclusives2-yuri.rpyc:434
translate chinese yuri_exclusive2_2_ch22_58805ea1:

    # "I watch Yuri pour a cup of tea for each of us."
    "我看着优里给我们各倒了一杯茶。"

# script-exclusives2-yuri.rpyc:435
translate chinese yuri_exclusive2_2_ch22_f2be1624:

    # y 1a "[player], I have another request."
    y 1a "[player]，我还有一个请求。"

# script-exclusives2-yuri.rpyc:436
translate chinese yuri_exclusive2_2_ch22_dcf2efbc:

    # y "Do you mind if we sit on the floor today?"
    y "你介意我们今天坐地上吗？"

# script-exclusives2-yuri.rpyc:437
translate chinese yuri_exclusive2_2_ch22_635adbe8:

    # mc "Eh? Why's that?"
    mc "诶？为什么？"

# script-exclusives2-yuri.rpyc:438
translate chinese yuri_exclusive2_2_ch22_953ca257:

    # y 1h "It's a little bit easier on my back..."
    y 1h "这样对我的背轻松一点……"

# script-exclusives2-yuri.rpyc:439
translate chinese yuri_exclusive2_2_ch22_4b80e874:

    # y "I can read with my back against the wall rather than bending over at my desk."
    y "我可以背靠着墙读书，而不是趴在课桌上弓着腰。"

# script-exclusives2-yuri.rpyc:440
translate chinese yuri_exclusive2_2_ch22_c34e0b47:

    # mc "Ah, sorry, I didn't realize."
    mc "啊，抱歉，我没注意到。"

# script-exclusives2-yuri.rpyc:441
translate chinese yuri_exclusive2_2_ch22_1b0a66cf:

    # y 1a "No worries."
    y 1a "没关系。"

# script-exclusives2-yuri.rpyc:442
translate chinese yuri_exclusive2_2_ch22_d5b75401:

    # y "I just have back pain fairly regularly, so I do my best to manage it."
    y "我只是背痛比较频繁，所以尽量缓解一下。"

# script-exclusives2-yuri.rpyc:443
translate chinese yuri_exclusive2_2_ch22_09f2de35:

    # mc "Is that so?"
    mc "是吗？"

# script-exclusives2-yuri.rpyc:444
translate chinese yuri_exclusive2_2_ch22_f735ccd8:

    # mc "I wonder why that is..."
    mc "我好奇那是为什么……"

# script-exclusives2-yuri.rpyc:445
translate chinese yuri_exclusive2_2_ch22_e8d54652:

    # y 1f "It's most likely because my--"
    y 1f "最可能是因为我的——"

# script-exclusives2-yuri.rpyc:446
translate chinese yuri_exclusive2_2_ch22_504ba04a:

    # y 1n "Ah--"
    y 1n "啊——"

# script-exclusives2-yuri.rpyc:447
translate chinese yuri_exclusive2_2_ch22_68c6e8a6:

    # y 1o "M-My..."
    y 1o "我、我的……"

# script-exclusives2-yuri.rpyc:448
translate chinese yuri_exclusive2_2_ch22_3c30f162:

    # mc "Your posture, right?"
    mc "是你的坐姿，对吧？"

# script-exclusives2-yuri.rpyc:449
translate chinese yuri_exclusive2_2_ch22_2462174e:

    # mc "Always hunched over like that while reading..."
    mc "读书的时候总是那样弓着背……"

# script-exclusives2-yuri.rpyc:450
translate chinese yuri_exclusive2_2_ch22_579a96b7:

    # y 2p "Yes!"
    y 2p "对！"

# script-exclusives2-yuri.rpyc:451
translate chinese yuri_exclusive2_2_ch22_ef46eb2d:

    # y 2q "I have terrible reading posture!"
    y 2q "我的阅读姿势糟糕透了！"

# script-exclusives2-yuri.rpyc:452
translate chinese yuri_exclusive2_2_ch22_5a43e3b2:

    # y "So that's why we should sit on the floor."
    y "所以我们才应该坐地上。"

# script-exclusives2-yuri.rpyc:453
translate chinese yuri_exclusive2_2_ch22_d5ae2301:

    # mc "Fair enough."
    mc "有道理。"

# script-exclusives2-yuri.rpyc:454
translate chinese yuri_exclusive2_2_ch22_ba08de52:

    # mc "I'll go ahead and get the book."
    mc "我去把书拿来。"

# script-exclusives2-yuri.rpyc:457
translate chinese yuri_exclusive2_2_ch22_fa75c129:

    # "I retrieve the book from my bag."
    "我从书包里取出书。"

# script-exclusives2-yuri.rpyc:458
translate chinese yuri_exclusive2_2_ch22_33179bd7:

    # mc "Ah, I have some chocolate as well..."
    mc "啊，我还有点巧克力……"

# script-exclusives2-yuri.rpyc:459
translate chinese yuri_exclusive2_2_ch22_0c515ba0:

    # "It's a bag of small chocolate candies."
    "那是一袋小巧克力糖。"

# script-exclusives2-yuri.rpyc:460
translate chinese yuri_exclusive2_2_ch22_e1063e85:

    # "I take it, since it'll go well with the tea."
    "我带上它，配茶正合适。"

# script-exclusives2-yuri.rpyc:461
translate chinese yuri_exclusive2_2_ch22_d9a2ecee:

    # "Yuri and I then sit against the wall, teacups at our sides."
    "优里和我随后靠墙坐下，茶杯放在身边。"

# script-exclusives2-yuri.rpyc:462
translate chinese yuri_exclusive2_2_ch22_ad740ef3:

    # "As if in sync, we assume the same reading position as last time, each holding one half of the book."
    "仿佛心有灵犀一般，我们摆出了和上次一样的读书姿势，各执书的一边。"

# script-exclusives2-yuri.rpyc:463
translate chinese yuri_exclusive2_2_ch22_308596e5:

    # "Except this time..."
    "只不过这一次……"

# script-exclusives2-yuri.rpyc:464
translate chinese yuri_exclusive2_2_ch22_de366d08:

    # "Our bodies are even closer to each other."
    "我们的身体靠得更近了。"

# script-exclusives2-yuri.rpyc:466
translate chinese yuri_exclusive2_2_ch22_5d023884:

    # y "I can't see too well..."
    y "我看不太清……"

# script-exclusives2-yuri.rpyc:467
translate chinese yuri_exclusive2_2_ch22_55feb8f4:

    # mc "--!"
    mc "——！"

# script-exclusives2-yuri.rpyc:469
translate chinese yuri_exclusive2_2_ch22_b25a40d6:

    # "Yuri slides closer until our shoulders are touching."
    "优里往我这边挪了挪，直到我们的肩膀相触。"

# script-exclusives2-yuri.rpyc:470
translate chinese yuri_exclusive2_2_ch22_85980a12:

    # "How am I supposed to focus on reading like this...?!"
    "这样我还怎么专心读书啊……？！"

# script-exclusives2-yuri.rpyc:471
translate chinese yuri_exclusive2_2_ch22_73b16b02:

    # "Yuri was always kind of cute, but..."
    "优里一直都有点可爱，但是……"

# script-exclusives2-yuri.rpyc:472
translate chinese yuri_exclusive2_2_ch22_784f0af8:

    # "When she's being less apprehensive, it's almost more than I can handle!"
    "当她不再那么拘谨的时候，简直让人招架不住！"

# script-exclusives2-yuri.rpyc:473
translate chinese yuri_exclusive2_2_ch22_afd2de9d:

    # y 2f "Your teacup..."
    y 2f "你的茶杯……"

# script-exclusives2-yuri.rpyc:474
translate chinese yuri_exclusive2_2_ch22_7075f030:

    # "Yuri hands me my teacup."
    "优里把我的茶杯递了过来。"

# script-exclusives2-yuri.rpyc:475
translate chinese yuri_exclusive2_2_ch22_b94c1535:

    # "Holding it with my hand that's not holding the book, I end up in a position that makes it even harder to focus."
    "我用没拿书的那只手接住，结果摆出的姿势更难集中注意力了。"

# script-exclusives2-yuri.rpyc:476
translate chinese yuri_exclusive2_2_ch22_738fef00:

    # "Because now I need to worry about making sure I don't accidentally touch her chest...!"
    "因为我现在还得小心，别不小心碰到她的胸口……！"

# script-exclusives2-yuri.rpyc:477
translate chinese yuri_exclusive2_2_ch22_31a38b20:

    # "Meanwhile, Yuri hasn't noticed a single thing."
    "与此同时，优里什么都没注意到。"

# script-exclusives2-yuri.rpyc:478
translate chinese yuri_exclusive2_2_ch22_cb5218b7:

    # "She wears her intense reading expression, and I can only presume the world around her has faded away."
    "她带着那副专注的阅读表情，我只能猜想周围的世界已经在她眼前消失了。"

# script-exclusives2-yuri.rpyc:479
translate chinese yuri_exclusive2_2_ch22_8b064b16:

    # "I use all of my willpower to focus on reading."
    "我用尽全部意志力，把注意力集中在读书上。"

# script-exclusives2-yuri.rpyc:480
translate chinese yuri_exclusive2_2_ch22_a20cefa7_1:

    # "..."
    "……"

# script-exclusives2-yuri.rpyc:481
translate chinese yuri_exclusive2_2_ch22_c510b9b5:

    # "After a few minutes, I finally manage to relax a little."
    "几分钟后，我终于放松了一点。"

# script-exclusives2-yuri.rpyc:482
translate chinese yuri_exclusive2_2_ch22_76549943:

    # "I put the teacup between my legs and fumble with the chocolate wrapper."
    "我把茶杯夹在两腿之间，笨手笨脚地拆巧克力包装。"

# script-exclusives2-yuri.rpyc:483
translate chinese yuri_exclusive2_2_ch22_2787f9a7:

    # mc "Ah, sorry..."
    mc "啊，抱歉……"

# script-exclusives2-yuri.rpyc:484
translate chinese yuri_exclusive2_2_ch22_61683ed9:

    # "I briefly let go of the book to finish opening the wrapper."
    "我暂时松开书，把包装完全打开。"

# script-exclusives2-yuri.rpyc:485
translate chinese yuri_exclusive2_2_ch22_0183dede:

    # mc "You can have as much as you want."
    mc "你想吃多少都可以。"

# script-exclusives2-yuri.rpyc:486
translate chinese yuri_exclusive2_2_ch22_a9ce267b:

    # y 2s "Ah, that's..."
    y 2s "啊，那……"

# script-exclusives2-yuri.rpyc:487
translate chinese yuri_exclusive2_2_ch22_54b4955c:

    # y "That's okay, I won't take any..."
    y "没关系，我不吃了……"

# script-exclusives2-yuri.rpyc:488
translate chinese yuri_exclusive2_2_ch22_276afef2:

    # mc "Eh? Are you sure?"
    mc "诶？你确定吗？"

# script-exclusives2-yuri.rpyc:489
translate chinese yuri_exclusive2_2_ch22_de41a4f9:

    # y 2v "Well..."
    y 2v "嗯……"

# script-exclusives2-yuri.rpyc:490
translate chinese yuri_exclusive2_2_ch22_701aa4c1:

    # y "If I touch it, then it might get smudges on the pages..."
    y "如果我碰的话，可能会在书页上留下污渍……"

# script-exclusives2-yuri.rpyc:491
translate chinese yuri_exclusive2_2_ch22_6a87efd4:

    # mc "Ah, you're right..."
    mc "啊，你说得对……"

# script-exclusives2-yuri.rpyc:492
translate chinese yuri_exclusive2_2_ch22_db8aec53:

    # mc "I didn't even think about that."
    mc "我都没想过这个。"

# script-exclusives2-yuri.rpyc:493
translate chinese yuri_exclusive2_2_ch22_9e480491:

    # mc "My bad..."
    mc "我的错……"

# script-exclusives2-yuri.rpyc:494
translate chinese yuri_exclusive2_2_ch22_0eb2861d:

    # y 2a "No need to apologize."
    y 2a "不用道歉。"

# script-exclusives2-yuri.rpyc:495
translate chinese yuri_exclusive2_2_ch22_13b3e059:

    # y "I'll hold the book, okay?"
    y "我来拿书，好吗？"

# script-exclusives2-yuri.rpyc:496
translate chinese yuri_exclusive2_2_ch22_977e733b:

    # mc "Are you sure...?"
    mc "你确定吗……？"

# script-exclusives2-yuri.rpyc:497
translate chinese yuri_exclusive2_2_ch22_d32f8ecc:

    # y "Of course."
    y "当然。"

# script-exclusives2-yuri.rpyc:509
translate chinese yuri_exclusive2_2_ch22_f9749fd6:

    # "Yuri opens the book with both hands."
    "优里用双手翻开书。"

# script-exclusives2-yuri.rpyc:510
translate chinese yuri_exclusive2_2_ch22_d4c91dff:

    # "She holds it so that I don't have any harder of a time reading from it."
    "她举着书，好让我读起来不吃力。"

# script-exclusives2-yuri.rpyc:511
translate chinese yuri_exclusive2_2_ch22_d764c329:

    # "But as a result, her left arm is practically resting on top of my leg."
    "但这样一来，她的左臂几乎就搭在我的腿上了。"

# script-exclusives2-yuri.rpyc:512
translate chinese yuri_exclusive2_2_ch22_59dd503e:

    # mc "Well, in that case..."
    mc "好吧，既然如此……"

# script-exclusives2-yuri.rpyc:513
translate chinese yuri_exclusive2_2_ch22_54138664:

    # "Yuri is already totally focused on reading again."
    "优里已经完全重新投入到阅读中去了。"

# script-exclusives2-yuri.rpyc:514
translate chinese yuri_exclusive2_2_ch22_a28daeb1:

    # "I take a chocolate candy and pop it into my mouth."
    "我拿起一颗巧克力糖，放进嘴里。"

# script-exclusives2-yuri.rpyc:515
translate chinese yuri_exclusive2_2_ch22_2fbb5434:

    # "Then, I take another chocolate..."
    "然后，我又拿了一颗巧克力……"

# script-exclusives2-yuri.rpyc:516
translate chinese yuri_exclusive2_2_ch22_6bf56b05:

    # "And I hold it up to Yuri."
    "递到优里面前。"

# script-exclusives2-yuri.rpyc:517
translate chinese yuri_exclusive2_2_ch22_73bd295b:

    # "She doesn't even look away from the book."
    "她甚至没有把视线从书上移开。"

# script-exclusives2-yuri.rpyc:518
translate chinese yuri_exclusive2_2_ch22_b1c5258a:

    # "She simply parts her lips, as if this situation was completely natural."
    "她只是微微张开嘴唇，仿佛这情形再自然不过。"

# script-exclusives2-yuri.rpyc:519
translate chinese yuri_exclusive2_2_ch22_cd91f7db:

    # "But that means I can't stop here!"
    "但这样一来，我就不能就此打住了！"

# script-exclusives2-yuri.rpyc:521
translate chinese yuri_exclusive2_2_ch22_dd709b9d:

    # "I apprehensively place the chocolate in her mouth."
    "我忐忑地把巧克力放进她嘴里。"

# script-exclusives2-yuri.rpyc:522
translate chinese yuri_exclusive2_2_ch22_ff42d43c:

    # "Just like that, Yuri closes her lips over it."
    "就这样，优里用嘴唇含住了它。"

# script-exclusives2-yuri.rpyc:523
translate chinese yuri_exclusive2_2_ch22_d1820aca:

    # y "Eh...?"
    y "诶……？"

# script-exclusives2-yuri.rpyc:525
translate chinese yuri_exclusive2_2_ch22_5dbb8342:

    # "Yuri's expression suddenly breaks."
    "优里的表情忽然绷不住了。"

# script-exclusives2-yuri.rpyc:526
translate chinese yuri_exclusive2_2_ch22_66238965:

    # y "Did..."
    y "刚刚……"

# script-exclusives2-yuri.rpyc:527
translate chinese yuri_exclusive2_2_ch22_64718e50:

    # y "Did I just..."
    y "我是不是刚刚……"

# script-exclusives2-yuri.rpyc:528
translate chinese yuri_exclusive2_2_ch22_f2565bf9:

    # "Yuri looks at me like she needs to confirm what just happened."
    "优里看着我，仿佛想确认刚才发生的事。"

# script-exclusives2-yuri.rpyc:534
translate chinese yuri_exclusive2_2_ch22_35dc00ff:

    # y "U-Um..."
    y "呃、呃……"

# script-exclusives2-yuri.rpyc:535
translate chinese yuri_exclusive2_2_ch22_c60c5441:

    # y "[player]..."
    y "[player]……"

# script-exclusives2-yuri.rpyc:536
translate chinese yuri_exclusive2_2_ch22_c817a551:

    # mc "S-Sorry!"
    mc "对、对不起！"

# script-exclusives2-yuri.rpyc:537
translate chinese yuri_exclusive2_2_ch22_304b7207:

    # mc "I guess I shouldn't have done that..."
    mc "我想我不该那样做……"

# script-exclusives2-yuri.rpyc:539
translate chinese yuri_exclusive2_2_ch22_ceede073:

    # y "A-Ah..."
    y "啊、啊……"

# script-exclusives2-yuri.rpyc:540
translate chinese yuri_exclusive2_2_ch22_66721784:

    # "Yuri starts to breathe heavily."
    "优里开始急促地喘气。"

# script-exclusives2-yuri.rpyc:541
translate chinese yuri_exclusive2_2_ch22_507dcdd3:

    # y "I..."
    y "我……"

# script-exclusives2-yuri.rpyc:542
translate chinese yuri_exclusive2_2_ch22_622ccc92:

    # y "I can't..."
    y "我受不了……"

# script-exclusives2-yuri.rpyc:543
translate chinese yuri_exclusive2_2_ch22_c60c5441_1:

    # y "[player]..."
    y "[player]……"

# script-exclusives2-yuri.rpyc:544
translate chinese yuri_exclusive2_2_ch22_c67875db:

    # "Suddenly, Yuri forcefully grabs my arm and jerks me to my feet."
    "突然，优里用力抓住我的胳膊，一把把我拽了起来。"

# script-exclusives2-yuri.rpyc:545
translate chinese yuri_exclusive2_2_ch22_5030e90f:

    # "My teacup gets knocked over."
    "我的茶杯被打翻了。"

# script-exclusives2-yuri.rpyc:549
translate chinese yuri_exclusive2_2_ch22_c60c5441_2:

