# script-ch30.rpyc:1187
translate chinese ch30_14_4e2c9324:

    # m "Just, I know you're a sweetheart, and you like to consider others' feelings, right? ZWF2b3IuIFJlYWxpemF0aW9uIHRoYXQgZnJlZWluZyBvdXIgYm9k"
