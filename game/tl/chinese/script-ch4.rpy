    mc "朋友不就是为了这个才存在的吗！"

# script-ch4.rpyc:151
translate chinese ch4_main_6adfa620:

    # mc "All you had to do was tell me!"
    mc "你只要告诉我就好了啊！"

# script-ch4.rpyc:152
translate chinese ch4_main_4c272a4c:

    # s 1bk "You don't understand at all, [player]."
    s 1bk "你完全不明白，[player]。"

