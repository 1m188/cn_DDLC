    # mc "...Why, Sayori?"
    mc "……为什么，纱世里？"

# script-ch4.rpyc:144
translate chinese ch4_main_82fc61d6:

    # s 1bg "Eh...?"
    s 1bg "诶……？"

# script-ch4.rpyc:145
translate chinese ch4_main_51dbc2b3:

    # mc "Why is it that you've never told me about this?"
    mc "为什么这种事，你从来都没有告诉过我？"

# script-ch4.rpyc:146
